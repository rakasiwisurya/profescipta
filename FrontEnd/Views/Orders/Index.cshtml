@using System.Globalization
@model FrontEnd.ViewModels.OrderListViewModel
@{
    ViewData["Title"] = "Order List";

    // Budaya Indonesia dipakai hanya untuk FORMAT tampilan angka & tanggal
    // (pemisah ribuan / dd/MM/yyyy). Nilainya sendiri berasal dari service.
    var idCulture = new CultureInfo("id-ID");
}

<div class="so-card">
    <div class="so-card-header">
        <h1 class="so-card-title">Sales Order</h1>

        <div class="d-flex gap-2">
            <a class="btn btn-success" asp-action="Create">+ Add New</a>
            <a class="btn btn-outline-primary"
               asp-action="Export"
               asp-route-keyword="@Model.Keyword"
               asp-route-orderDate="@Model.OrderDate?.ToString("yyyy-MM-dd")">
                &#8681; Export
            </a>
        </div>
    </div>

    <div class="so-card-body">
        @if (Model.ErrorMessage is not null)
        {
            <div class="alert alert-danger">
                <strong>Gagal memuat data.</strong> @Model.ErrorMessage
            </div>
        }

        @* -------------------- Filter pencarian -------------------- *@
        <form method="get" asp-action="Index" class="so-filter mb-3">
            <div class="row g-2 align-items-center">
                <div class="col-12 col-md-auto">
                    <label class="form-label mb-0 me-2" for="keyword">Keyword</label>
                </div>
                <div class="col-12 col-md-4">
                    <input type="text" class="form-control" id="keyword" name="keyword"
                           value="@Model.Keyword"
                           placeholder="SO Number, Customer, atau Address" />
                </div>

                <div class="col-12 col-md-auto">
                    <label class="form-label mb-0 me-2" for="orderDate">Order Date</label>
                </div>
                <div class="col-12 col-md-3">
                    <input type="date" class="form-control" id="orderDate" name="orderDate"
                           value="@Model.OrderDate?.ToString("yyyy-MM-dd")" />
                </div>

                <div class="col-12 col-md-auto d-flex gap-2">
                    <button type="submit" class="btn btn-primary">&#128269; Search</button>
                    <a class="btn btn-light border" asp-action="Index">Reset</a>
                </div>
            </div>
        </form>

        @* -------------------- Grid order -------------------- *@
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="so-col-num">#</th>
                        <th>SO Number</th>
                        <th style="width: 140px;">Order Date</th>
                        <th>Customer</th>
                        <th>Address</th>
                        <th class="so-col-total">Grand Total</th>
                        <th class="so-col-action">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Orders.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="so-empty">
                                Tidak ada data order yang cocok dengan pencarian.
                            </td>
                        </tr>
                    }
                    else
                    {
                        var rowNumber = Model.FirstRowNumber;

                        foreach (var order in Model.Orders)
                        {
                            <tr>
                                <td class="so-col-num">@rowNumber</td>
                                <td>@order.SoNo</td>
                                <td>@order.OrderDate.ToString("dd/MM/yyyy")</td>
                                <td>@order.CustomerName</td>
                                <td>@order.Address</td>
                                <td class="text-money">@order.GrandTotal.ToString("N2", idCulture)</td>
                                <td class="so-col-action">
                                    <a class="btn-icon" title="Edit order"
                                       asp-action="Edit" asp-route-id="@order.SalesSoId">&#9998;</a>

                                    @* Tombol hapus hanya membuka popup konfirmasi;
                                       nomor SO diteruskan agar bisa ditampilkan dinamis. *@
                                    <button type="button" class="btn-icon js-delete-order"
                                            title="Hapus order"
                                            data-order-id="@order.SalesSoId"
                                            data-order-no="@order.SoNo">&#128465;</button>
                                </td>
                            </tr>

                            rowNumber++;
                        }
                    }
                </tbody>
            </table>
        </div>

        @* -------------------- Paging -------------------- *@
        @if (Model.TotalPages > 1)
        {
            <nav class="mt-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <span class="text-muted small">
                    Menampilkan @Model.Orders.Count dari @Model.TotalOrders order
                    (halaman @Model.CurrentPage dari @Model.TotalPages)
                </span>

                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-keyword="@Model.Keyword"
                           asp-route-orderDate="@Model.OrderDate?.ToString("yyyy-MM-dd")"
                           asp-route-page="@(Model.CurrentPage - 1)">&#9664;</a>
                    </li>

                    @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                    {
                        <li class="page-item @(pageNumber == Model.CurrentPage ? "active" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-keyword="@Model.Keyword"
                               asp-route-orderDate="@Model.OrderDate?.ToString("yyyy-MM-dd")"
                               asp-route-page="@pageNumber">@pageNumber</a>
                        </li>
                    }

                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-keyword="@Model.Keyword"
                           asp-route-orderDate="@Model.OrderDate?.ToString("yyyy-MM-dd")"
                           asp-route-page="@(Model.CurrentPage + 1)">&#9654;</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>

@* -------------------- Popup konfirmasi hapus -------------------- *@
<div class="modal fade" id="deleteOrderModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-action="Delete">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="deleteOrderId" />
                <input type="hidden" name="keyword" value="@Model.Keyword" />
                <input type="hidden" name="orderDate" value="@Model.OrderDate?.ToString("yyyy-MM-dd")" />

                <div class="modal-header">
                    <h5 class="modal-title">Konfirmasi Hapus</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button>
                </div>

                <div class="modal-body">
                    @* Nomor SO diisi JavaScript sesuai baris yang diklik. *@
                    <p class="mb-0">
                        Hapus order <strong id="deleteOrderNo"></strong>?
                        Tindakan ini tidak dapat dibatalkan.
                    </p>
                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-danger">Ya, Hapus</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/order-list.js" asp-append-version="true"></script>
}
